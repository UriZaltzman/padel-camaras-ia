{
  "extends": ["expo/tsconfig.base", "@app/config/tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023"],
    "module": "preserve",
    "customConditions": ["react-native"],
    "types": ["jest"],
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js"]
}
