{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node --env-file-if-exists=../../.env dist/main.cjs\"",
    "start": "node dist/main.cjs",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "6.19.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.3.17",
    "ioredis": "^6.0.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "testcontainers": "^12.2.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^2.1.5",
    "yaml": "^2.8.1"
  }
}
