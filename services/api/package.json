{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:errors": "node scripts/generate-error-codes.mjs",
    "lint": "eslint .",
    "typecheck": "node scripts/generate-error-codes.mjs && tsc --noEmit",
    "test": "node scripts/generate-error-codes.mjs && vitest run",
    "build": "node scripts/generate-error-codes.mjs && tsup",
    "dev": "node scripts/generate-error-codes.mjs && tsup --watch --onSuccess \"node --env-file-if-exists=../../.env dist/main.cjs\"",
    "start": "node dist/main.cjs",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^2.1.5",
    "yaml": "^2.8.1"
  }
}
