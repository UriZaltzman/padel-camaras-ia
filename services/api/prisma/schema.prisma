// Database schema (especificación §2). Owner: arquitecto.
//
// Conventions:
// - Every `id` is a UUID v7 generated by the application (not the database), so ids are
//   time-ordered, known before the INSERT and identical across services. Backend generates them
//   with a UUID v7 library (e.g. `uuidv7()` from the `uuidv7` package) in the repository layer.
//   There is deliberately no `@default` on ids: an INSERT without an id fails loudly.
// - `created_at` / `updated_at` are `timestamptz` and always stored in UTC.
// - Tables with an owner carry `club_id` (needed for row level security, §12).
// - Money is an integer number of cents (ARS) in `*_cents` columns. Percentages are basis points
//   (`*_bps`, 1500 = 15.00 %) to avoid floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- People

enum PlayerCategory {
  cat_8
  cat_7
  cat_6
  cat_5
  cat_4
  cat_3
  cat_2
  cat_1

  @@map("player_category")
}

enum Handedness {
  right
  left

  @@map("handedness")
}

enum PlayingSide {
  drive
  reves
  both

  @@map("playing_side")
}

enum AuthProvider {
  whatsapp
  google
  apple
  email

  @@map("auth_provider")
}

enum MembershipRole {
  owner
  staff
  coach
  player

  @@map("membership_role")
}

enum MembershipStatus {
  invited
  active
  revoked

  @@map("membership_status")
}

model User {
  id                  String          @id @db.Uuid
  name                String
  /// E.164, used for WhatsApp login. Unique when present.
  phone               String?         @unique
  email               String?         @unique
  photoUrl            String?         @map("photo_url")
  declaredCategory    PlayerCategory? @map("declared_category")
  handedness          Handedness?
  playingSide         PlayingSide?    @map("playing_side")
  birthDate           DateTime?       @map("birth_date") @db.Date
  // Consents (§12): timestamp + document version record what was accepted and when.
  termsAcceptedAt     DateTime?       @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion        String?         @map("terms_version")
  privacyAcceptedAt   DateTime?       @map("privacy_accepted_at") @db.Timestamptz(3)
  privacyVersion      String?         @map("privacy_version")
  /// Player asked that their videos are not used to train models.
  trainingOptOut      Boolean         @default(false) @map("training_opt_out")
  trainingOptOutAt    DateTime?       @map("training_opt_out_at") @db.Timestamptz(3)
  /// Account deletion requested; data is purged within 30 days (§12).
  deletionRequestedAt DateTime?       @map("deletion_requested_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  authIdentities     AuthIdentity[]
  memberships        Membership[]
  bookingsCreated    Booking[]       @relation("BookingCreatedBy")
  bookingsAsGuardian Booking[]       @relation("BookingGuardian")
  bookingPlayers     BookingPlayer[] @relation("BookingPlayerUser")
  bookingInvitesSent BookingPlayer[] @relation("BookingPlayerInvitedBy")

  @@map("users")
}

model AuthIdentity {
  id         String       @id @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  /// Provider subject: phone for whatsapp, `sub` for google/apple, address for email.
  externalId String       @map("external_id")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
  @@map("auth_identities")
}

model Membership {
  id        String           @id @db.Uuid
  clubId    String           @map("club_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A user holds each role at most once per club (a coach can also be a player).
  @@unique([clubId, userId, role])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------- Clubs

enum ClubPlan {
  loan
  purchase

  @@map("club_plan")
}

enum CourtStatus {
  active
  maintenance
  inactive

  @@map("court_status")
}

model Club {
  id                     String   @id @db.Uuid
  name                   String
  address                String?
  /// 11 digits, no dashes.
  cuit                   String?  @unique
  /// IANA zone, e.g. America/Argentina/Buenos_Aires.
  timezone               String   @default("America/Argentina/Buenos_Aires")
  logoUrl                String?  @map("logo_url")
  sponsorName            String?  @map("sponsor_name")
  sponsorLogoUrl         String?  @map("sponsor_logo_url")
  plan                   ClubPlan
  // Charge settings (§10).
  /// Price a player pays for the match extras; null = the club does not charge.
  playerExtraPriceCents  Int?     @map("player_extra_price_cents")
  /// Booking deposit; null = no deposit required.
  depositCents           Int?     @map("deposit_cents")
  /// Mercado Pago account that receives the club's share (split payments).
  mercadopagoCollectorId String?  @map("mercadopago_collector_id")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships           Membership[]
  courts                Court[]
  contracts             Contract[]
  bookingSlotsRules     BookingSlotsRule[]
  bookingRulePriceBands BookingRulePriceBand[]
  bookings              Booking[]
  bookingPlayers        BookingPlayer[]
  devices               Device[]
  cameras               Camera[]
  calibrations          Calibration[]

  @@map("clubs")
}

model Court {
  id                   String      @id @db.Uuid
  clubId               String      @map("club_id") @db.Uuid
  name                 String
  covered              Boolean     @default(false)
  status               CourtStatus @default(active)
  /// Current calibration (one of the calibrations of this court's cameras; the application
  /// checks that the calibration's camera belongs to this court).
  currentCalibrationId String?     @unique @map("current_calibration_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  club               Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  currentCalibration Calibration?       @relation("CourtCurrentCalibration", fields: [currentCalibrationId], references: [id], onDelete: SetNull)
  bookingSlotsRules  BookingSlotsRule[]
  bookings           Booking[]
  cameras            Camera[]

  @@unique([clubId, name])
  @@map("courts")
}

model Contract {
  id                     String    @id @db.Uuid
  clubId                 String    @map("club_id") @db.Uuid
  plan                   ClubPlan
  /// Monthly fee per court, ARS cents.
  feePerCourtAmountCents Int       @map("fee_per_court_amount_cents")
  startsOn               DateTime  @map("starts_on") @db.Date
  endsOn                 DateTime? @map("ends_on") @db.Date
  minimumMonths          Int       @map("minimum_months")
  /// Commission on payments processed for the club, basis points (1500 = 15 %).
  commissionBps          Int       @map("commission_bps")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@index([clubId, startsOn])
  @@map("contracts")
}

// ---------------------------------------------------------------- Equipment (§2, §4, §5)

enum CameraEnd {
  a
  b

  @@map("camera_end")
}

enum CameraStatus {
  /// Installed and streaming.
  active
  /// Installed but the device cannot read the stream.
  offline
  /// Taken out of service (broken, being replaced).
  disabled

  @@map("camera_status")
}

/// The club's edge computer (Jetson). It authenticates with its own mTLS certificate (§11);
/// heartbeat fields are updated by `POST /device/heartbeat`.
model Device {
  id              String    @id @db.Uuid
  clubId          String    @map("club_id") @db.Uuid
  serialNumber    String    @unique @map("serial_number")
  softwareVersion String?   @map("software_version")
  /// Last heartbeat; null until the first one.
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(3)
  /// Free disk reported in the last heartbeat, bytes.
  freeDiskBytes   BigInt?   @map("free_disk_bytes")
  /// GPU temperature reported in the last heartbeat, degrees Celsius.
  gpuTemperatureC Decimal?  @map("gpu_temperature_c") @db.Decimal(5, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  club    Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  cameras Camera[]

  @@index([clubId])
  @@map("devices")
}

/// One of the 2 cameras of a court (end A or B), read by a device over RTSP.
///
/// The RTSP address (it contains the camera password) is never stored in plain text (§12).
/// The API encrypts it with envelope encryption before the INSERT:
/// - Algorithm AES-256-GCM. A fresh random 12-byte nonce per write.
/// - `rtsp_url_ciphertext` = nonce (12 bytes) || ciphertext || GCM tag (16 bytes).
/// - Additional authenticated data = the camera `id` (UTF-8), so a ciphertext copied to another
///   row fails to decrypt.
/// - `rtsp_url_key_id` names the data key in the key manager (KMS / secret store) used for this
///   row, e.g. `rtsp/2026-10`. Rotating = new key id for new writes plus a re-encryption job;
///   old keys are kept until no row references them.
/// The key never lives in the database. Only the API decrypts, to hand the address to the
/// device of the same club over mTLS.
model Camera {
  id                String       @id @db.Uuid
  clubId            String       @map("club_id") @db.Uuid
  courtId           String       @map("court_id") @db.Uuid
  deviceId          String       @map("device_id") @db.Uuid
  end               CameraEnd
  rtspUrlCiphertext Bytes        @map("rtsp_url_ciphertext")
  rtspUrlKeyId      String       @map("rtsp_url_key_id")
  /// Stream resolution in pixels (2560x1440 by default, §4).
  resolutionWidth   Int          @map("resolution_width") @db.SmallInt
  resolutionHeight  Int          @map("resolution_height") @db.SmallInt
  status            CameraStatus @default(active)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  club         Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  court        Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  calibrations Calibration[]

  @@unique([courtId, end])
  @@index([deviceId])
  @@index([clubId])
  @@map("cameras")
}

/// A camera calibration (§5 step 1). Rows are immutable: recalibrating inserts a new row and
/// moves `courts.current_calibration_id`.
model Calibration {
  id         String   @id @db.Uuid
  clubId     String   @map("club_id") @db.Uuid
  cameraId   String   @map("camera_id") @db.Uuid
  /// The 12 reference points marked on the image, in pixels, flattened as
  /// [x1, y1, x2, y2, ..., x12, y12] (24 numbers). Point i is the i-th known court point in the
  /// fixed order defined by vision-ia (CHECK: exactly 24 non-null values).
  pointsPx   Float[]  @map("points_px")
  /// Homography image -> court plane in metres, 3x3 row-major [h11, h12, h13, h21, ..., h33]
  /// (CHECK: exactly 9 non-null values).
  homography Float[]
  /// Mean reprojection error in centimetres (CHECK >= 0; the console rejects > 5 cm, §15).
  errorCm    Decimal  @map("error_cm") @db.Decimal(6, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  club           Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)
  camera         Camera @relation(fields: [cameraId], references: [id], onDelete: Restrict)
  currentOfCourt Court? @relation("CourtCurrentCalibration")

  @@index([cameraId, createdAt])
  @@index([clubId])
  @@map("calibrations")
}

// ---------------------------------------------------------------- Bookings (§9)

/// Values must match `BookingStatus` in packages/contracts (state machine §3).
enum BookingStatus {
  held
  confirmed
  completed
  cancelled
  no_show
  expired

  @@map("booking_status")
}

enum BookingOrigin {
  app
  panel

  @@map("booking_origin")
}

enum DepositKind {
  /// No deposit: the booking is confirmed immediately.
  none
  /// Fixed amount in `deposit_amount_cents`.
  fixed
  /// Share of the price in `deposit_bps`.
  percent

  @@map("deposit_kind")
}

/// Booking rules of one court. A court may have several rules (e.g. weekdays vs weekend);
/// the application must not create overlapping rules for the same weekday.
/// CHECK constraints (durations, interval, deposit) live in the migration SQL.
model BookingSlotsRule {
  id                      String      @id @db.Uuid
  clubId                  String      @map("club_id") @db.Uuid
  courtId                 String      @map("court_id") @db.Uuid
  /// ISO weekdays the rule applies to: 1 = Monday ... 7 = Sunday.
  daysOfWeek              Int[]       @map("days_of_week") @db.SmallInt
  /// Local time in the club's timezone. `closes_at` <= `opens_at` means it closes after midnight.
  opensAt                 DateTime    @map("opens_at") @db.Time(0)
  closesAt                DateTime    @map("closes_at") @db.Time(0)
  /// Subset of {60, 90, 120}.
  allowedDurationsMinutes Int[]       @map("allowed_durations_minutes") @db.SmallInt
  /// Possible starts every N minutes from `opens_at` (e.g. 30).
  startIntervalMinutes    Int         @map("start_interval_minutes") @db.SmallInt
  depositKind             DepositKind @default(none) @map("deposit_kind")
  depositAmountCents      Int?        @map("deposit_amount_cents")
  depositBps              Int?        @map("deposit_bps")
  /// A player can cancel (and get the deposit back) up to N hours before the start.
  cancellationHours       Int         @default(24) @map("cancellation_hours") @db.SmallInt
  active                  Boolean     @default(true)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Restrict)
  court      Court                  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  priceBands BookingRulePriceBand[]

  @@index([courtId])
  @@index([clubId])
  @@map("booking_slots_rules")
}

/// Price per time band inside a rule (e.g. 08:00-17:00 off-peak, 17:00-closing peak), one row
/// per allowed duration. A booking takes the price of the band its start falls into.
model BookingRulePriceBand {
  id              String   @id @db.Uuid
  clubId          String   @map("club_id") @db.Uuid
  ruleId          String   @map("rule_id") @db.Uuid
  startsAt        DateTime @map("starts_at") @db.Time(0)
  endsAt          DateTime @map("ends_at") @db.Time(0)
  durationMinutes Int      @map("duration_minutes") @db.SmallInt
  /// Price of the whole slot for this duration, ARS cents.
  priceCents      Int      @map("price_cents")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  club Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  rule BookingSlotsRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, startsAt, durationMinutes])
  @@index([clubId])
  @@map("booking_rule_price_bands")
}

/// The non-overlap guarantee (exclusion constraint on court_id + tstzrange(starts_at, ends_at)
/// for status held/confirmed) is added in #39; the columns it needs are already here.
model Booking {
  id                   String        @id @db.Uuid
  clubId               String        @map("club_id") @db.Uuid
  courtId              String        @map("court_id") @db.Uuid
  startsAt             DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime      @map("ends_at") @db.Timestamptz(3)
  status               BookingStatus @default(held)
  /// Price fixed at booking time, ARS cents.
  priceCents           Int           @map("price_cents")
  depositPaidCents     Int           @default(0) @map("deposit_paid_cents")
  origin               BookingOrigin
  /// Required while `held` (10 minutes after creation, §9).
  holdExpiresAt        DateTime?     @map("hold_expires_at") @db.Timestamptz(3)
  /// Player who booked (app) or staff member who loaded it (panel).
  createdByUserId      String?       @map("created_by_user_id") @db.Uuid
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  // Minors (§12): never recorded without a guardian permission stored on the booking.
  includesMinors       Boolean       @default(false) @map("includes_minors")
  guardianUserId       String?       @map("guardian_user_id") @db.Uuid
  guardianPermissionAt DateTime?     @map("guardian_permission_at") @db.Timestamptz(3)
  /// "Do not record" (kids' classes by default, §12); the edge scheduler skips these bookings.
  noRecord             Boolean       @default(false) @map("no_record")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  club      Club            @relation(fields: [clubId], references: [id], onDelete: Restrict)
  court     Court           @relation(fields: [courtId], references: [id], onDelete: Restrict)
  createdBy User?           @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  guardian  User?           @relation("BookingGuardian", fields: [guardianUserId], references: [id], onDelete: SetNull)
  players   BookingPlayer[]

  @@index([courtId, startsAt])
  @@index([clubId, startsAt])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

model BookingPlayer {
  id              String    @id @db.Uuid
  clubId          String    @map("club_id") @db.Uuid
  bookingId       String    @map("booking_id") @db.Uuid
  /// 1 = whoever booked; 2..4 = invited (CHECK 1..4 in the migration SQL).
  position        Int       @db.SmallInt
  /// Null until the invitation link is accepted.
  userId          String?   @map("user_id") @db.Uuid
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  accepted        Boolean   @default(false)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  club      Club    @relation(fields: [clubId], references: [id], onDelete: Restrict)
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User?   @relation("BookingPlayerUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy User?   @relation("BookingPlayerInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([bookingId, position])
  @@unique([bookingId, userId])
  @@index([userId])
  @@index([clubId])
  @@map("booking_players")
}
