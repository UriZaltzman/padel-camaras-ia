# Local development only. Real secrets live in the secrets manager, never in the repo.
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
# 32+ characters; development falls back to a built-in value, production requires it.
#AUTH_OTP_SECRET=
# PKCS#8 PEM of an EC P-256 key (openssl ecparam -genkey -name prime256v1 | openssl pkcs8 -topk8 -nocrypt).
# Development generates a throwaway key at startup, so sessions end when the API restarts.
#AUTH_JWT_PRIVATE_KEY=
#MERCADOPAGO_WEBHOOK_SECRET=
#MERCADOPAGO_ACCESS_TOKEN=
