{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UriZaltzman/padel-camaras-ia/packages/contracts/events/device.offline.schema.json",
  "title": "DeviceOfflineEvent",
  "description": "`device.offline`: A club device stopped sending heartbeats.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "schema_version", "payload"],
  "properties": {
    "event_id": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "event_type": {
      "const": "device.offline"
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "schema_version": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        }
      ],
      "const": 1
    },
    "payload": {
      "title": "DeviceOfflinePayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "club_id", "last_heartbeat_at", "offline_since"],
      "properties": {
        "device_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "club_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "last_heartbeat_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "offline_since": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "0192a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b",
      "event_type": "device.offline",
      "occurred_at": "2026-10-20T23:30:00Z",
      "schema_version": 1,
      "payload": {
        "device_id": "01921f6e-7c1a-7d4e-9b3a-2f6c8e1d4a57",
        "club_id": "0192cf6e-7c1a-7d4e-9b3a-2f6c8e1d4a52",
        "last_heartbeat_at": "2026-10-20T21:58:00Z",
        "offline_since": "2026-10-20T22:03:00Z"
      }
    }
  ]
}
