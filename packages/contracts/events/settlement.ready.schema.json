{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UriZaltzman/padel-camaras-ia/packages/contracts/events/settlement.ready.schema.json",
  "title": "SettlementReadyEvent",
  "description": "`settlement.ready`: The monthly settlement of a club was drafted (1st of the month) and awaits approval: status `draft`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "schema_version", "payload"],
  "properties": {
    "event_id": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "event_type": {
      "const": "settlement.ready"
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "schema_version": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        }
      ],
      "const": 1
    },
    "payload": {
      "title": "SettlementReadyPayload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settlement_id",
        "club_id",
        "period",
        "status",
        "gross_cents",
        "platform_fee_cents",
        "net_cents"
      ],
      "properties": {
        "settlement_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "club_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "description": "Settled month, `YYYY-MM`."
        },
        "status": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/SettlementStatus"
            }
          ],
          "const": "draft"
        },
        "gross_cents": {
          "$ref": "common.schema.json#/$defs/AmountCents"
        },
        "platform_fee_cents": {
          "$ref": "common.schema.json#/$defs/AmountCents"
        },
        "net_cents": {
          "$ref": "common.schema.json#/$defs/AmountCents"
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "0192a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b",
      "event_type": "settlement.ready",
      "occurred_at": "2026-10-20T23:30:00Z",
      "schema_version": 1,
      "payload": {
        "settlement_id": "0192df6e-7c1a-7d4e-9b3a-2f6c8e1d4a53",
        "club_id": "0192cf6e-7c1a-7d4e-9b3a-2f6c8e1d4a52",
        "period": "2026-09",
        "status": "draft",
        "gross_cents": 250000000,
        "platform_fee_cents": 25000000,
        "net_cents": 225000000
      }
    }
  ]
}
