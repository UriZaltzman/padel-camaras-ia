{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UriZaltzman/padel-camaras-ia/packages/contracts/events/match.recorded.schema.json",
  "title": "MatchRecordedEvent",
  "description": "`match.recorded`: Recording ended and the video was uploaded: `recording` -> `recorded`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "schema_version", "payload"],
  "properties": {
    "event_id": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "event_type": {
      "const": "match.recorded"
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "schema_version": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        }
      ],
      "const": 1
    },
    "payload": {
      "title": "MatchRecordedPayload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "club_id",
        "court_id",
        "device_id",
        "status",
        "started_at",
        "ended_at",
        "duration_seconds"
      ],
      "properties": {
        "match_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "club_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "court_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "device_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "status": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/MatchStatus"
            }
          ],
          "const": "recorded"
        },
        "started_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "ended_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "0192a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b",
      "event_type": "match.recorded",
      "occurred_at": "2026-10-20T23:30:00Z",
      "schema_version": 1,
      "payload": {
        "match_id": "01920f6e-7c1a-7d4e-9b3a-2f6c8e1d4a56",
        "club_id": "0192cf6e-7c1a-7d4e-9b3a-2f6c8e1d4a52",
        "court_id": "0192df6e-7c1a-7d4e-9b3a-2f6c8e1d4a53",
        "device_id": "01921f6e-7c1a-7d4e-9b3a-2f6c8e1d4a57",
        "status": "recorded",
        "started_at": "2026-10-20T22:00:05Z",
        "ended_at": "2026-10-20T23:29:50Z",
        "duration_seconds": 5385
      }
    }
  ]
}
