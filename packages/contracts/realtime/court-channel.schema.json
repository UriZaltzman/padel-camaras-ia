      "payload": {
        "match_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a5b",
        "requested_by_user_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a71"
      }
    },
    {
      "type": "error",
      "id": "0192f1a0-1b2c-7d3e-8f4a-5b6c7d8e9f0a",
      "sent_at": "2026-10-23T22:31:20Z",
      "court_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a61",
      "payload": {
        "code": "RATE_LIMITED",
        "message": "Esperá unos segundos para marcar otro clip.",
        "in_reply_to": "0192f1a0-1b2c-7d3e-8f4a-5b6c7d8e9f03"
      }
