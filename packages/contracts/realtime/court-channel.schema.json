      "id": "0192f1a0-1b2c-7d3e-8f4a-5b6c7d8e9f05",
      "sent_at": "2026-10-23T22:31:21Z",
      "court_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a61",
      "payload": {
        "request_id": "0192f1a0-1b2c-7d3e-8f4a-5b6c7d8e9f10",
        "status": "cutting",
        "media_id": null,
        "code": null
      }
    },
    {
      "type": "clip.progress",
      "id": "0192f1a0-1b2c-7d3e-8f4a-5b6c7d8e9f06",
