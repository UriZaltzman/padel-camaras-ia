      "id": "0192f1a0-1b2c-7d3e-8f4a-5b6c7d8e9f03",
      "sent_at": "2026-10-23T22:31:15Z",
      "court_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a61",
      "payload": {
        "match_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a5b",
        "client_tapped_at": "2026-10-23T22:31:14Z"
      }
    },
    {
      "type": "clip.request",
      "id": "0192f1a0-1b2c-7d3e-8f4a-5b6c7d8e9f04",
      "sent_at": "2026-10-23T22:31:15Z",
      "court_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a61",
