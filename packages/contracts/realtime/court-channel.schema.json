      "court_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a61",
      "payload": {
        "request_id": "0192f1a0-1b2c-7d3e-8f4a-5b6c7d8e9f10",
        "match_id": "01928f6e-7c1a-7d4e-9b3a-2f6c8e1d4a5b",
        "status": "ready",
        "clip_id": "0192af6e-7c1a-7d4e-9b3a-2f6c8e1d4a50",
