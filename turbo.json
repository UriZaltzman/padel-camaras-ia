{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["prisma:generate"]
    },
    "typecheck": {
      "dependsOn": ["prisma:generate"]
    },
    "test": {
      "env": ["TEST_DATABASE_ADMIN_URL"],
      "outputs": [],
      "dependsOn": ["prisma:generate"]
    },
    "format:check": {},
    "contracts:generate": {
      "outputs": ["generated/**"]
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "dependsOn": ["db:migrate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "prisma:generate": {
      "cache": false
    }
  }
}
