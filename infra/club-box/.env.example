# Club box settings. Copy to .env (chmod 600) and fill in. Never commit .env.
# Every value below is a placeholder, not a real secret.

# Image of the club agent ("club" target). The default is built locally: docker compose build.
EDGE_IMAGE=edge-agent:local

# Issued when the box is registered in the console.
EDGE_CLUB_ID=00000000-0000-0000-0000-000000000000
EDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000
EDGE_API_BASE_URL=https://api.example.invalid
EDGE_LOG_LEVEL=INFO
TZ=America/Argentina/Buenos_Aires

# Host folders, owned by uid 10001 (see INSTALL.md).
EDGE_STATE_DIR=/srv/edge-agent/state
EDGE_RECORDINGS_DIR=/srv/edge-agent/recordings

# Camera LAN: NIC wired to the PoE switch, its subnet, and the recorder's address on it.
CAMERA_NIC=enp3s0
CAMERA_SUBNET=10.50.0.0/24
RECORDER_CAMERA_IP=10.50.0.2

# One line of JSON. court-1-a = behind the back glass of side A, court-1-b = side B.
EDGE_RECORDER_CAMERAS={"court-1-a": "rtsp://USUARIO:CLAVE@10.50.0.11:554/Streaming/Channels/101", "court-1-b": "rtsp://USUARIO:CLAVE@10.50.0.12:554/Streaming/Channels/101"}

# S3-compatible storage (Cloudflare R2). Keys scoped to this bucket only.
EDGE_UPLOADER_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
EDGE_UPLOADER_BUCKET=padel-fase0
EDGE_UPLOADER_ACCESS_KEY_ID=REEMPLAZAR
EDGE_UPLOADER_SECRET_ACCESS_KEY=REEMPLAZAR
EDGE_UPLOADER_REGION=auto
EDGE_UPLOADER_KEY_PREFIX=segments/
EDGE_UPLOADER_BANDWIDTH_LIMIT_BYTES_PER_S=625000
